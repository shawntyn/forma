          },
          "surface": {
            "$type": "dimension",
            "$value": "{primitive.dimension.radiusLarge}",
            "$description": "容器圆角"
          }
        },
        "space": {
          "unit": {
            "$type": "dimension",
            "$value": "{primitive.dimension.unit}",
