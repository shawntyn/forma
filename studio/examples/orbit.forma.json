      "component": {
        "button": {
          "radius": {
            "$type": "dimension",
            "$value": "{semantic.radius.control}",
            "$description": "按钮圆角"
          },
          "height": {
            "$type": "dimension",
            "$value": "{semantic.size.controlHeight}",
            "$description": "按钮高度"
          }
        },
        "input": {
          "radius": {
            "$type": "dimension",
            "$value": "{semantic.radius.control}",
            "$description": "输入框圆角"
          },
          "height": {
            "$type": "dimension",
            "$value": "{semantic.size.controlHeight}",
            "$description": "输入框高度"
          }
        },
        "card": {
          "radius": {
            "$type": "dimension",
            "$value": "{semantic.radius.surface}",
            "$description": "卡片圆角"
          },
          "padding": {
            "$type": "dimension",
            "$value": "{semantic.space.sectionInline}",
            "$description": "卡片内边距"
          }
        }
      }
