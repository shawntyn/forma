        "motion": {
          "normal": {
            "$type": "duration",
            "$value": {
              "value": 160,
              "unit": "ms"
            },
            "$description": "标准动效时长"
          }
        },
        "shadow": {
          "soft": {
            "$type": "shadow",
            "$value": {
              "color": {
                "colorSpace": "srgb",
                "components": [
                  0.09019607843137255,
                  0.08235294117647059,
                  0.10588235294117647
                ],
                "alpha": 0.08
              },
              "offsetX": {
                "value": 0,
                "unit": "rem"
              },
              "offsetY": {
                "value": 0.125,
                "unit": "rem"
              },
              "blur": {
                "value": 0.75,
                "unit": "rem"
              },
              "spread": {
                "value": 0,
                "unit": "rem"
              }
            },
            "$description": "柔和阴影"
          }
        }
      },
      "semantic": {
